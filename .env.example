DATABASE_URL="postgresql://user:password@localhost:5432/smart_shopping_list?schema=public"
JWT_SECRET="your_jwt_secret_key_here"
PORT=3001

# URL do backend usada pelo frontend (route handlers do Next.js).
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Origens permitidas para CORS no backend (separadas por vírgula).
# Em produção, inclua o domínio do frontend.
CORS_ORIGINS=http://localhost:3000

# Instruções importantes:
# 1. Copie este arquivo para backend/.env e configure as variáveis do backend.
# 2. Crie frontend/.env.local com NEXT_PUBLIC_BACKEND_URL.
# 3. Substitua os valores pelas suas configurações reais.
# 4. NUNCA commite arquivos .env com dados reais para o repositório.
# 5. Para produção, use credenciais seguras e conexão SSL no banco.
# 6. Gere o JWT_SECRET com: openssl rand -hex 32
